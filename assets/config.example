# /etc/server-backup/config, права 600. Значения ключей человек вписывает сам в своём терминале, не через чат с агентом.

# --- Хранилище: у другой компании, не у твоего хостинга ---
RESTIC_REPOSITORY="s3:https://АДРЕС_ХРАНИЛИЩА/ИМЯ_БАКЕТА/ИМЯ_СЕРВЕРА"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION=""
RESTIC_PASSWORD_FILE="/etc/server-backup/password"

# --- Что сохраняем ---
# Только папки, которые есть на этом сервере. Отдельный диск и данные Docker в именованных томах добавляй явно
# (том: /var/lib/docker/volumes/ИМЯ/_data), кроме томов с файлами работающих баз.
BACKUP_PATHS=(/etc /root /home /opt /srv /var/www /var/spool/cron /usr/local/bin /usr/local/sbin)
# Не сохраняем: файлы работающих баз (база идёт дампом), кэш, зависимости, логи.
BACKUP_EXCLUDES=(node_modules .cache __pycache__ '*.log')
# Дополнительно не кладём в аварийный архив для компьютера: только тяжёлое, что можно пережить без него (видео, большие медиа).
# Договоры, документы и загрузки клиентов не исключай, если они помещаются: это самое ценное.
EMERGENCY_EXCLUDES=()

# --- Сколько версий хранить в облаке ---
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# --- Уведомления ---
TG_TOKEN=""
TG_CHAT=""
# Сторож вне сервера (например, Healthchecks.io): поднимет тревогу, если сервер замолчал совсем.
HC_URL=""

# yes, когда компьютер начал забирать аварийный архив: сервер заметит, если он перестанет.
PULL_EXPECTED="no"
